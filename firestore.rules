rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios
    match /users/{userId} {
      // ✅ Permitir queries limitadas para verificar username disponible (sin auth)
      // ✅ Permitir queries autenticadas (para getUsersByIds, getConnectedUsers, etc.)
      allow list: if request.auth != null || 
                     (request.auth == null && request.query.limit <= 1);
      
      // ✅ Leer tu propio perfil siempre
      // ✅ Leer otros perfiles solo si estás autenticado (necesario para getConnectedUsers)
      // La lógica de negocio en el cliente ya controla qué usuarios mostrar
      allow get: if request.auth != null;
      
      // ✅ Crear solo tu propio perfil (el userId debe coincidir con el auth.uid)
      allow create: if request.auth != null && 
                       request.auth.uid == userId;
      
      // ✅ Actualizar solo tu propio perfil
      allow update: if request.auth != null && 
                       request.auth.uid == userId;
      
      // ✅ Eliminar solo tu propio perfil
      allow delete: if request.auth != null && 
                       request.auth.uid == userId;
    }
    
    // Conexiones
    match /connections/{connectionId} {
      // ✅ Leer un documento específico donde eres participante
      allow get: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Permitir queries (list) autenticadas
      // Las queries siempre filtran por userId1 o userId2 == auth.uid en el código
      // La seguridad real está en 'get' que valida que solo leas tus conexiones
      allow list: if request.auth != null;
      
      // ✅ Crear solo si eres uno de los usuarios en la conexión
      allow create: if request.auth != null && (
        request.resource.data.userId1 == request.auth.uid ||
        request.resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Actualizar solo si eres uno de los usuarios en la conexión
      allow update: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Eliminar solo si eres uno de los usuarios en la conexión
      allow delete: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
    }
    
    // Invitaciones de conexión
    match /connection_invitations/{invitationId} {
      // ✅ Permitir lectura pública (necesario para deep links)
      allow read: if true;
      
      // ✅ Crear solo si eres el fromUserId
      allow create: if request.auth != null && 
                       request.resource.data.fromUserId == request.auth.uid;
      
      // ✅ Actualizar solo si eres el creador
      allow update: if request.auth != null && 
                       resource.data.fromUserId == request.auth.uid;
      
      // ✅ Eliminar solo si eres el creador
      allow delete: if request.auth != null && 
                       resource.data.fromUserId == request.auth.uid;
    }
    
    // Gift Groups (Group Gifting Feature)
    match /giftGroups/{groupId} {
      // Helper function: check if user is a member of the group
      function isMember() {
        return request.auth != null && 
               exists(/databases/$(database)/documents/giftGroups/$(groupId)/members/$(request.auth.uid));
      }
      
      // Helper function: check if user is the creator
      function isCreator() {
        return request.auth != null && 
               resource.data.creatorId == request.auth.uid;
      }
      
      // Helper function: check if user is an accepted member
      function isAcceptedMember() {
        return request.auth != null && 
               exists(/databases/$(database)/documents/giftGroups/$(groupId)/members/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/giftGroups/$(groupId)/members/$(request.auth.uid)).data.status == 'accepted';
      }
      
      // ✅ Get: members can read group details, or creator can read during creation
      allow get: if isMember() || isCreator();
      
      // ✅ List: allow authenticated users to query their own groups
      allow list: if request.auth != null;
      
      // ✅ Create: any authenticated user can create a group
      allow create: if request.auth != null && 
                       request.resource.data.creatorId == request.auth.uid;
      
      // ✅ Update: only creator can update group details
      allow update: if isCreator();
      
      // ✅ Delete: only creator can delete (though we'll use status instead)
      allow delete: if isCreator();
      
      // Members subcollection
      match /members/{memberId} {
        // ✅ Read: any member can see all members in their group
        // ✅ Also allow users to query their own memberships (for collectionGroup queries)
        allow read: if isMember() || 
                       (request.auth != null && resource.data.userId == request.auth.uid);
        
        // ✅ List: allow authenticated users to query their own memberships across all groups
        allow list: if request.auth != null;
        
        // ✅ Create: only creator can invite members
        allow create: if request.auth != null && 
                         get(/databases/$(database)/documents/giftGroups/$(groupId)).data.creatorId == request.auth.uid;
        
        // ✅ Update: creator can update any member, or user can update their own status (accept/reject)
        allow update: if (request.auth != null && 
                          get(/databases/$(database)/documents/giftGroups/$(groupId)).data.creatorId == request.auth.uid) ||
                         (request.auth != null && memberId == request.auth.uid);
        
        // ✅ Delete: only creator can remove members
        allow delete: if request.auth != null && 
                         get(/databases/$(database)/documents/giftGroups/$(groupId)).data.creatorId == request.auth.uid;
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        // ✅ Read: any member can read messages
        allow read: if isMember();
        
        // ✅ Create: accepted members can send user messages, or any member can send system messages
        allow create: if (isAcceptedMember() && request.resource.data.senderId == request.auth.uid) ||
                         (isMember() && request.resource.data.type == 'system' && request.resource.data.senderId == 'system');
        
        // ✅ Update/Delete: not allowed (messages are immutable)
        allow update, delete: if false;
      }
    }
  }
}
