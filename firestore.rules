rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios
    match /users/{userId} {
      // ✅ Permitir queries limitadas para verificar username disponible (sin auth)
      // ✅ Permitir queries autenticadas (para getUsersByIds, getConnectedUsers, etc.)
      allow list: if request.auth != null || 
                     (request.auth == null && request.query.limit <= 1);
      
      // ✅ Leer tu propio perfil siempre
      // ✅ Leer otros perfiles solo si estás autenticado (necesario para getConnectedUsers)
      // La lógica de negocio en el cliente ya controla qué usuarios mostrar
      allow get: if request.auth != null;
      
      // ✅ Crear solo tu propio perfil (el userId debe coincidir con el auth.uid)
      allow create: if request.auth != null && 
                       request.auth.uid == userId;
      
      // ✅ Actualizar solo tu propio perfil
      allow update: if request.auth != null && 
                       request.auth.uid == userId;
      
      // ✅ Eliminar solo tu propio perfil
      allow delete: if request.auth != null && 
                       request.auth.uid == userId;
    }
    
    // Conexiones
    match /connections/{connectionId} {
      // ✅ Leer un documento específico donde eres participante
      allow get: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Permitir queries (list) autenticadas
      // Las queries siempre filtran por userId1 o userId2 == auth.uid en el código
      // La seguridad real está en 'get' que valida que solo leas tus conexiones
      allow list: if request.auth != null;
      
      // ✅ Crear solo si eres uno de los usuarios en la conexión
      allow create: if request.auth != null && (
        request.resource.data.userId1 == request.auth.uid ||
        request.resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Actualizar solo si eres uno de los usuarios en la conexión
      allow update: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
      
      // ✅ Eliminar solo si eres uno de los usuarios en la conexión
      allow delete: if request.auth != null && (
        resource.data.userId1 == request.auth.uid ||
        resource.data.userId2 == request.auth.uid
      );
    }
    
    // Invitaciones de conexión
    match /connection_invitations/{invitationId} {
      // ✅ Permitir lectura pública (necesario para deep links)
      allow read: if true;
      
      // ✅ Crear solo si eres el fromUserId
      allow create: if request.auth != null && 
                       request.resource.data.fromUserId == request.auth.uid;
      
      // ✅ Actualizar solo si eres el creador
      allow update: if request.auth != null && 
                       resource.data.fromUserId == request.auth.uid;
      
      // ✅ Eliminar solo si eres el creador
      allow delete: if request.auth != null && 
                       resource.data.fromUserId == request.auth.uid;
    }
  }
}
